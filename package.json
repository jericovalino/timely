{
  "name": "timely",
  "private": true,
  "scripts": {
    "build": "turbo run build --filter=@repo/admin --filter=@repo/kiosk --filter=@repo/timely-server",
    "dev": "turbo run dev --filter=@repo/admin --filter=@repo/kiosk --filter=@repo/timely-server",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "konva": "^10.2.1",
    "react-konva": "^19.2.3",
    "styled-components": "^6.3.11"
  }
}
